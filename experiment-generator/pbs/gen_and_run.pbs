#!/bin/bash
# Generate the branches for one sweep YAML, then for each branch: make a git worktree and `payu run` (payu submits
# the model job itself to normalsr). copyq: payu fetches a metadata schema from GitHub; only copyq has internet.
# Usage: qsub -P <project> -v YAML=/abs/sweep.yaml,NAME=coriolis_jet[,NRUNS=2] gen_and_run.pbs
# NAME = repository_directory in the YAML. Branches and worktrees go under the YAML's test_path.
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/vk83
# (add +gdata/<project> to the storage line above for your own /g/data paths)
#PBS -l wd
#PBS -j oe
set -e
[ -n "$YAML" ] && [ -n "$NAME" ] || { echo 'need -v YAML=...,NAME=...'; exit 1; }
module purge
module use /g/data/vk83/modules
module load payu/1.3.6_1
E=$(awk '/^test_path:/{print $2}' "$YAML")
cd "$(dirname "$YAML")"
[ -n "$SKIPGEN" ] || experiment-generator -i "$YAML"
git -C "$E/$NAME" checkout -q main   # generator leaves the repo on its last branch, which blocks a worktree for it
for b in $(git -C "$E/$NAME" for-each-ref --format='%(refname:short)' refs/heads | grep -v '^main$'); do
  echo "== $b"
  [ -d "$E/wt/$b/$NAME" ] && continue   # already has a worktree, so payu run was already submitted
  git -C "$E/$NAME" worktree add "$E/wt/$b/$NAME" "$b"
  cd "$E/wt/$b/$NAME"; payu run -n ${NRUNS:-1}; cd - >/dev/null
done
